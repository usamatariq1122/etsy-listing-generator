# --- Server ---
PORT=4000

# --- Text provider ---
# The portal generates listing text only, so only a text backend needs an API
# key here. Set TEXT_PROVIDER=anthropic to use Claude instead.
TEXT_PROVIDER=gemini

# --- Google AI Studio (Gemini text model) ---
# gemini-3.8-flash verified working 2026-10-15. If Google retires it, list
# available models with: GET https://generativelanguage.googleapis.com/v1beta/models?key=YOUR_KEY
# The offered names live in server/models.json; this overrides which of them is
# asked first (leave it empty to use the first name in that file).
GEMINI_API_KEY=AQ.paste-your-gemini-key-here
GEMINI_TEXT_MODEL=

# --- Claude (text, optional — only if TEXT_PROVIDER=anthropic) ---
ANTHROPIC_API_KEY=sk-ant-your-key-here
ANTHROPIC_MODEL=claude-sonnet-5-5

# --- Groq (second text provider, optional) ---
# Asked after Gemini when every Gemini model is busy or out of free requests,
# or before it when a Groq model is selected in Settings. Keys come from
# console.groq.com; the endpoint is OpenAI-compatible.
# The names offered in Settings live in server/models.json under "groq"; this
# overrides which of them is used when no Groq model is chosen in Settings.
GROQ_API_KEY=
GROQ_MODEL=

# --- OpenRouter (third text provider, optional) ---
# Asked after Groq when both earlier providers decline, or first when one of its
# models is selected in Settings. Keys come from openrouter.ai/keys and start
# with sk-or-. One key reaches every model in its catalogue, and each model is
# billed per request there instead of on a daily free quota.
# The names offered in Settings live in server/models.json under "openrouter";
# this overrides which of them is used when no OpenRouter model is chosen there.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# --- Database ---
# Hosted, Netlify's managed Postgres arrives as NETLIFY_DB_URL and you never set
# anything here; locally `netlify dev` does the same. Only running
# `node src/index.js` on its own needs a URL of your own:
# DATABASE_URL=postgres://user:password@host:5432/dbname

# --- Encryption of saved API keys ---
# Keys you paste into Settings are stored in the database encrypted with
# AES-256-GCM, and this is the only copy of that key. Generate one:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Locally put it here; on Netlify add it as a site secret named ENCRYPTION_KEY
# and redeploy. Keys saved before you set this are encrypted on the first
# request after that redeploy. If you ever change this value, the keys already
# in the database can no longer be read and have to be pasted again.
ENCRYPTION_KEY=

# --- Etsy (optional, off by default) ---
# Creates a draft listing in your own shop through Etsy's Open API v3. Leave
# ETSY_ENABLED unset (or anything but true) and nothing Etsy-related appears in
# the interface; the ZIP download works exactly as before.
# Register an app at etsy.com/developers/register, request the listings_w scope,
# and wait until Etsy marks the key as approved — nothing works before that.
# Then put the key string and the shared secret here, and locally as Netlify
# site secrets of the same names. Never commit them.
ETSY_ENABLED=false
ETSY_KEYSTRING=
ETSY_SHARED_SECRET=
# The callback URL you registered for the app, matched character for character.
# Hosted, this is the site URL plus /api/etsy/callback.
ETSY_REDIRECT_URI=

# --- Accounts (email for verification and reset, optional) ---
# Sign-up and sign-in work with no key set; only the confirmation/reset email
# needs Resend. Add RESEND_API_KEY as a site secret, set MAIL_FROM to a sender
# you verified in Resend, and SITE_URL to this deployment's public origin so the
# emailed links point back here. With no RESEND_API_KEY nothing is sent and no
# network is touched.
RESEND_API_KEY=
MAIL_FROM=Listora <onboarding@resend.dev>
MAIL_REPLY_TO=
SITE_URL=

# --- Daily generation quota per account ---
# How many listing generations one signed-in account may start per day. The
# owner (the first account / admin) is exempt. Set to 0 to remove the cap.
GENERATION_DAILY_LIMIT=20
